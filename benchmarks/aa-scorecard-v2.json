        "content": "\n\n```swift\nfunc shortestSubarrayAtLeastK(_ nums: [Int], _ k: Int) -> Int {\n    let n = nums.count\n    var prefixSum = Array(repeating: 0, count: n + 1)\n    for i in 0..<n {\n        prefixSum[i + 1] = prefixSum[i] + nums[i]\n    }\n    \n    var deque = Array(repeating: 0, count: n + 1)\n    var head = 0\n    var tail = 0\n    var minLength = Int.max\n    \n    for j in 0...n {\n        while head < tail && prefixSum[j] - prefixSum[deque[head]] >= k {\n            minLength = min(minLength, j - deque[head])\n            head += 1\n        }\n        \n        while head < tail && prefixSum[deque[tail - 1]] >= prefixSum[j] {\n            tail -= 1\n        }\n        \n        deque[tail] = j\n        tail += 1\n    }\n    \n    return minLength == Int.max ? -1 : minLength\n}\n```",
